{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "producer",
    "created_at",
    "passed",
    "approved",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "evidence": {}
        }
      }
    },
    "approved": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "file",
          "severity",
          "issue",
          "suggestion"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "issue": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "axis": {
            "enum": [
              "standards",
              "spec"
            ]
          },
          "acceptance_ref": {
            "type": "string",
            "pattern": "^a[0-9]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "axis": {
                  "const": "spec"
                }
              },
              "required": [
                "axis"
              ]
            },
            "then": {
              "required": [
                "acceptance_ref"
              ]
            }
          }
        ]
      }
    },
    "spec_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "acceptance_ref",
          "covered"
        ],
        "properties": {
          "acceptance_ref": {
            "type": "string",
            "pattern": "^a[0-9]+$"
          },
          "covered": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approved": {
            "const": true
          }
        },
        "required": [
          "approved"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "severity": {
                  "const": "minor"
                }
              }
            }
          },
          "spec_coverage": {
            "items": {
              "properties": {
                "covered": {
                  "const": true
                }
              }
            }
          }
        },
        "required": [
          "spec_coverage"
        ]
      }
    }
  ]
}
