{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "producer",
    "created_at",
    "passed",
    "findings"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "evidence": {}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "repro_cmd"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "invariant": {
            "type": "string"
          },
          "repro_cmd": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "case_file": {
            "type": "string"
          }
        }
      }
    },
    "attempted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
